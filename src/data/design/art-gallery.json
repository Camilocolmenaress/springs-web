            "fontSize": { "value": 1.05, "unit": "rem", "min": 0.5, "max": 2.5, "step": 0.05 },
            "paddingH": { "value": 24,   "unit": "px",  "min": 8,   "max": 80,  "step": 1 },
            "paddingV": { "value": 10,   "unit": "px",  "min": 4,   "max": 40,  "step": 1 }
          }
        }
      }
    },

    "infoPanel_contenido": {
