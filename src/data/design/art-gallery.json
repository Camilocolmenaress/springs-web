          }
        },
        "descripcion": {
          "props": {
            "fontSize": { "value": 0.44, "unit": "rem", "min": 0.25, "max": 0.9, "step": 0.01 }
          }
        },
        "tagline": {
          "props": {
            "fontSize": { "value": 0.46, "unit": "rem", "min": 0.25, "max": 0.9, "step": 0.01 }
          }
        },
        "quote": {
          "props": {
            "fontSize": { "value": 0.58, "unit": "rem", "min": 0.3, "max": 1.5, "step": 0.01 }
          }
        },
        "specs": {
          "props": {
            "fontSize": { "value": 0.43, "unit": "rem", "min": 0.25, "max": 0.9, "step": 0.01 }
          }
        }
      }
