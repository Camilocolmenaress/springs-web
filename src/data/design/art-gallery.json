{
  "zones": {
    "layout": {
      "label": "Layout Global",
      "elements": {
        "sidebar": {
          "props": {
            "width": { "value": 159, "unit": "px", "min": 100, "max": 320, "step": 1 }
          }
        },
        "nav": {
          "props": {
            "height": { "value": 39, "unit": "px", "min": 32, "max": 100, "step": 1 }
          }
        },
        "footer": {
          "props": {
            "height": { "value": 57, "unit": "px", "min": 28, "max": 80, "step": 1 }
          }
        },
        "infoPanel": {
          "props": {
            "width": { "value": 600, "unit": "px", "min": 200, "max": 700, "step": 4 }
          }
        }
      }
    },

    "sidebar_contenido": {
