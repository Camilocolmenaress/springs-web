{
  "page": "home-mobile",
  "zones": {
    "hero": {
      "label": "Hero",
      "elements": {
        "productImage": {
          "type": "image",
          "props": {
            "width":   { "value": 100, "unit": "%",  "min": 60,   "max": 100,  "step": 1 },
            "offsetY": { "value": 18,  "unit": "px", "min": -150, "max": 150,  "step": 2 }
