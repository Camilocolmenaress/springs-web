{
  "page": "art-gallery-mobile",
  "zones": {
    "hero": {
      "label": "Hero",
      "elements": {
        "productImage": {
          "type": "image",
          "props": {
            "width":   { "value": 75, "unit": "%", "min": 40, "max": 100, "step": 1 },
            "objectY": { "value": 15, "unit": "%", "min": 0,  "max": 100, "step": 1 }
          }
        },
        "overlayText": {
          "type": "text",
          "props": {
            "top":  { "value": 16, "unit": "%", "min": 5,  "max": 60,  "step": 0.5 },
            "left": { "value": 34, "unit": "%", "min": 20, "max": 65,  "step": 1   }
          }
        },
        "galleryLabel": {
          "type": "text",
          "props": {
            "fontSize": { "value": 0.44, "unit": "rem", "min": 0.2, "max": 0.8, "step": 0.02 }
          }
        },
        "productName": {
          "type": "text",
          "props": {
            "fontSize": { "value": 13, "unit": "vw", "min": 5, "max": 22, "step": 0.5 }
          }
        },
        "sidebar": {
          "type": "text",
          "props": {
            "width":    { "value": 36,   "unit": "%",   "min": 20,  "max": 52,  "step": 1    },
            "fontSize": { "value": 0.37, "unit": "rem", "min": 0.2, "max": 0.7, "step": 0.01 }
          }
        },
        "globe": {
          "type": "image",
          "props": {
            "size": { "value": 64, "unit": "px", "min": 40, "max": 120, "step": 4 }
          }
        }
      }
    },
    "detail": {
      "label": "Detalle",
      "elements": {
        "layout": {
          "type": "text",
          "props": {
            "paddingTop":   { "value": 28, "unit": "px", "min": 0,  "max": 80, "step": 4 },
            "paddingH":     { "value": 16, "unit": "px", "min": 8,  "max": 40, "step": 2 },
            "leftColWidth": { "value": 44, "unit": "%",  "min": 20, "max": 60, "step": 1 }
          }
        },
        "pullQuote": {
          "type": "text",
          "props": {
            "fontSize": { "value": 0.78, "unit": "rem", "min": 0.4, "max": 1.5, "step": 0.02 }
          }
        },
        "ingredients": {
          "type": "text",
          "props": {
            "fontSize": { "value": 0.39, "unit": "rem", "min": 0.2, "max": 0.8, "step": 0.01 }
          }
        },
        "description": {
          "type": "text",
          "props": {
            "fontSize": { "value": 0.38, "unit": "rem", "min": 0.2, "max": 0.8, "step": 0.01 }
          }
        },
        "tagline": {
          "type": "text",
          "props": {
            "fontSize": { "value": 0.40, "unit": "rem", "min": 0.2, "max": 0.8, "step": 0.01 }
          }
        },
        "quote": {
          "type": "text",
          "props": {
            "fontSize": { "value": 0.60, "unit": "rem", "min": 0.3, "max": 1.2, "step": 0.02 }
          }
        }
      }
    }
  }
}
